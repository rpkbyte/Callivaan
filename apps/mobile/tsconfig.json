{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "typeRoots": [
      "./node_modules/@types"
    ],
    "baseUrl": ".",
    "paths": {
      "react-native": [
        "types/react-native.d.ts"
      ]
    }
  },
  "include": [
    "components/**/*",
    "screens/**/*",
    "types/**/*",
    "data/**/*",
    "theme.ts",
    "index.ts",
    "App.tsx"
  ],
  "extends": "expo/tsconfig.base"
}
