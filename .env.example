# Callivaan Environment Configuration Template
# Copy to .env for local development with your local or test credentials.
# NEVER commit production credentials to source control.

# Application Environment
NODE_ENV=development
APP_ENV=local
PORT=4000
MEDIA_PORT=4001
WORKER_PORT=4002
WEB_PORT=3000
API_BASE_URL=http://localhost:4000
MEDIA_BASE_URL=ws://localhost:4001
WEB_BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Security and Authentication
JWT_SECRET=replace_with_a_secure_random_string_min_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
PASSWORD_SALT_ROUNDS=12

# Database (PostgreSQL)
DATABASE_URL=postgres://callivaan:callivaan_dev_password@localhost:5432/callivaan_dev
DB_POOL_MIN=2
DB_POOL_MAX=10

# Redis (Job Queue and transient caching)
REDIS_URL=redis://localhost:6379

# Telephony Provider (Exotel / Mock Telephony Adapter)
TELEPHONY_PROVIDER=mock
EXOTEL_ACCOUNT_SID=placeholder_exotel_account_sid
EXOTEL_API_KEY=placeholder_exotel_api_key
EXOTEL_API_TOKEN=placeholder_exotel_api_token
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_WEBHOOK_SECRET=placeholder_exotel_webhook_hmac_secret
EXOTEL_VIRTUAL_NUMBER=+918000000000

# Voice AI Provider (Realtime Voice / Mock AI Adapter)
VOICE_AI_PROVIDER=mock
VOICE_AI_API_KEY=placeholder_voice_ai_key
VOICE_AI_MODEL=gpt-4o-realtime-preview
VOICE_AI_TIMEOUT_MS=15000
VOICE_AI_MAX_CALL_DURATION_SECONDS=300
VOICE_AI_DEFAULT_LANGUAGE=hi-IN

# WhatsApp Business Platform
WHATSAPP_PROVIDER=mock
WHATSAPP_PHONE_NUMBER_ID=placeholder_wa_phone_id
WHATSAPP_BUSINESS_ACCOUNT_ID=placeholder_wa_waba_id
WHATSAPP_ACCESS_TOKEN=placeholder_wa_system_user_token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=placeholder_wa_verify_token
WHATSAPP_APP_SECRET=placeholder_wa_app_secret
WHATSAPP_SUMMARY_TEMPLATE_ID=call_summary_v1
WHATSAPP_ALERT_TEMPLATE_ID=urgent_alert_v1

# Payment Provider (Razorpay / Cashfree / Mock)
BILLING_PROVIDER=mock
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_razorpay_webhook_secret

# Operational Guardrails & Retention
CALL_RECORDING_ENABLED=false
TRANSCRIPT_STORAGE_ENABLED=false
DEFAULT_RETENTION_DAYS=90
PER_TENANT_MONTHLY_SPEND_CAP_INR=5000
USAGE_WARNING_THRESHOLD_PERCENT=80
LOG_LEVEL=info
REDACT_PII=true
